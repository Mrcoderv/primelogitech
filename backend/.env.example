# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=your-backend-domain.onrender.com,localhost,127.0.0.1

# CORS Settings - set to False in production and specify CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:3000

# Database (optional - for production database)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Port
PORT=8000
