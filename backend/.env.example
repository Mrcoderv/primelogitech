# ──────────────────────────────────────────────────────────────
# Prime Logic Tech — Environment Variables
# ──────────────────────────────────────────────────────────────
# How to use:
#
#   LOCAL DEV       cp .env.example .env
#
#   RENDER (free)   render.yaml sets most vars automatically.
#                   For vars with sync:false in render.yaml,
#                   add them in Render Dashboard →
#                   primelogitech-backend → Environment.
#
#   VERCEL          Add VITE_API_URL in Vercel Dashboard →
#                   primelogitech → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════
# DJANGO CORE
# ══════════════════════════════════════════════════════════════

# Turn off debug in production
DEBUG=False

# Generate a real secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-real-secret-key

# Comma-separated hostnames Django will accept
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ══════════════════════════════════════════════════════════════
# CORS  —  comma-separated frontend origins
# ══════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=https://primelogictech.vercel.app,https://primelogitech.vercel.app,http://localhost:5173,http://localhost:3000

# ══════════════════════════════════════════════════════════════
# PORT  —  Render uses this (default 8000)
# ══════════════════════════════════════════════════════════════
PORT=8000

# ══════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════
# Render provides this automatically via render.yaml.
# For local dev, uncomment the SQLite default (no change needed):
# DATABASE_URL=postgres://user:password@host:port/dbname

# ══════════════════════════════════════════════════════════════
# CLOUDINARY  —  media storage (OPTIONAL but needed for images)
# ══════════════════════════════════════════════════════════════
# Get these from https://console.cloudinary.com → Dashboard
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ══════════════════════════════════════════════════════════════
# ADMIN SUPERUSER  —  auto-created on every Render deploy
# ══════════════════════════════════════════════════════════════
# Set these in Render Dashboard → Environment (they are sync:false
# in render.yaml so they're never stored in git).
# ADMIN_USERNAME=raghav
# ADMIN_PASSWORD=raghav@3456
# ADMIN_EMAIL=admin@primelogitech.com

# ══════════════════════════════════════════════════════════════
# EMAIL  —  Gmail SMTP for contact form (OPTIONAL)
# ══════════════════════════════════════════════════════════════
# Use a Google App Password (not your regular password):
#   https://myaccount.google.com/apppasswords
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

# ══════════════════════════════════════════════════════════════
# VERCEL (frontend) — set this in Vercel Dashboard only
# ══════════════════════════════════════════════════════════════
# VITE_API_URL=https://primelogitech-backend.onrender.com
